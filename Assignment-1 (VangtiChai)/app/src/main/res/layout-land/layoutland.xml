<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Top Amount Display -->
    <TextView
        android:id="@+id/tvAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/taka_prefix"
        android:textSize="24sp"
        android:textColor="#000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:id="@+id/llContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintTop_toBottomOf="@id/tvAmount"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp">

        <!-- Left side: 2 columns of notes -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView android:id="@+id/tvNote500" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="500: 0" android:textSize="20sp" android:textColor="#000000" android:layout_marginBottom="12dp"/>
                <TextView android:id="@+id/tvNote100" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100: 0" android:textSize="20sp" android:textColor="#000000" android:layout_marginBottom="12dp"/>
                <TextView android:id="@+id/tvNote50" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="50: 0" android:textSize="20sp" android:textColor="#000000" android:layout_marginBottom="12dp"/>
                <TextView android:id="@+id/tvNote20" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="20: 0" android:textSize="20sp" android:textColor="#000000"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView android:id="@+id/tvNote10" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10: 0" android:textSize="20sp" android:textColor="#000000" android:layout_marginBottom="12dp"/>
                <TextView android:id="@+id/tvNote5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5: 0" android:textSize="20sp" android:textColor="#000000" android:layout_marginBottom="12dp"/>
                <TextView android:id="@+id/tvNote2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2: 0" android:textSize="20sp" android:textColor="#000000" android:layout_marginBottom="12dp"/>
                <TextView android:id="@+id/tvNote1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1: 0" android:textSize="20sp" android:textColor="#000000"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Right side: 4-column keypad -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/btn1" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="1" android:textSize="18sp" android:textColor="#000000" app:backgroundTint="#D6D7D7" app:cornerRadius="0dp" android:layout_margin="2dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn2" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="2" android:textSize="18sp" android:textColor="#000000" app:backgroundTint="#D6D7D7" app:cornerRadius="0dp" android:layout_margin="2dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn3" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="3" android:textSize="18sp" android:textColor="#000000" app:backgroundTint="#D6D7D7" app:cornerRadius="0dp" android:layout_margin="2dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn4" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="4" android:textSize="18sp" android:textColor="#000000" app:backgroundTint="#D6D7D7" app:cornerRadius="0dp" android:layout_margin="2dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/btn5" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="5" android:textSize="18sp" android:textColor="#000000" app:backgroundTint="#D6D7D7" app:cornerRadius="0dp" android:layout_margin="2dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn6" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="6" android:textSize="18sp" android:textColor="#000000" app:backgroundTint="#D6D7D7" app:cornerRadius="0dp" android:layout_margin="2dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn7" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="7" android:textSize="18sp" android:textColor="#000000" app:backgroundTint="#D6D7D7" app:cornerRadius="0dp" android:layout_margin="2dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn8" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="8" android:textSize="18sp" android:textColor="#000000" app:backgroundTint="#D6D7D7" app:cornerRadius="0dp" android:layout_margin="2dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/btn9" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="9" android:textSize="18sp" android:textColor="#000000" app:backgroundTint="#D6D7D7" app:cornerRadius="0dp" android:layout_margin="2dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn0" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="0" android:textSize="18sp" android:textColor="#000000" app:backgroundTint="#D6D7D7" app:cornerRadius="0dp" android:layout_margin="2dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnClear" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="2" android:text="CLEAR" android:textSize="16sp" android:textColor="#000000" app:backgroundTint="#D6D7D7" app:cornerRadius="0dp" android:layout_margin="2dp"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>